SOME_API_KEY=your_key_here
SOME_SECRET=your_secret_here
SOME_TOKEN=your_token_here

# Phase-2 network overrides (D-16). Unset = use config/<role>/network.json.
PURSUIT_HOST=your_host_here
PURSUIT_PORT=your_port_here
PURSUIT_OPPONENT_URL=your_opponent_url_here

# Phase-4 language layer (D-32). Read via os.environ.get() only -- never a
# config field, never a default, never a file (CLAUDE.md rules 39-40).
# Unset = claude_api provider degrades to NO_KEY -> template fallback (D-33).
ANTHROPIC_API_KEY=your-key-here
