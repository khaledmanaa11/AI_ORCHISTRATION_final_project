SOME_API_KEY=your_key_here
SOME_SECRET=your_secret_here
SOME_TOKEN=your_token_here

# Phase-2 network overrides (D-16). Unset = use config/<role>/network.json.
PURSUIT_HOST=your_host_here
PURSUIT_PORT=your_port_here
PURSUIT_OPPONENT_URL=your_opponent_url_here

# Phase-4 language layer (D-32). Read via os.environ.get() only -- never a
# config field, never a default, never a file (CLAUDE.md rules 39-40).
# Unset = claude_api provider degrades to NO_KEY -> template fallback (D-33).
ANTHROPIC_API_KEY=your-key-here

# Phase-5 cloud exposure and tunneling (D-54..D-57). Read via
# os.environ.get() only. Names come from config/<role>/tunnel.json
# (authtoken_env/domain_env/secret_env); unset = tunnel-off / secret-off,
# the default every existing test and loopback dev flow uses.
NGROK_AUTHTOKEN=your-ngrok-authtoken-here
PURSUIT_NGROK_DOMAIN=your-claimed-static-domain-here
PURSUIT_TUNNEL_SECRET=your-shared-secret-here

# Phase-7 reporting -- send-only Gmail (07-04). Read via os.environ.get()
# only. The NAMES come from config/<role>/reporting.json
# (credentials_env_var/token_env_var); the VALUES are filesystem paths to
# files that must never enter git -- .gitignore already carries
# credentials.json, client_secret*.json, token.json, token.pickle and *.token.
# The OAuth client is restricted to the gmail.send scope and nothing else
# (rule 30). Unset = no live send is possible, which is what every shipped
# config selects (reporting.mode = dry_run).
PURSUIT_GMAIL_CREDENTIALS_PATH=your-oauth-client-secret-path-here
PURSUIT_GMAIL_TOKEN_PATH=your-oauth-token-cache-path-here
